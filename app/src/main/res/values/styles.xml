<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="MainWindowButtonStyle" parent="Widget.MaterialComponents.Button.UnelevatedButton">
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">@dimen/main_text_size</item>
        <item name="cornerRadius">@dimen/main_button_corner_radius</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:textColor">@color/yp_black</item>
        <item name="android:letterSpacing">0.0</item>
        <item name="android:backgroundTint">@color/white</item>
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">0dp</item>
        <item name="android:layout_weight">1</item>
        <item name="iconGravity">textStart</item>
        <item name="iconPadding">@dimen/main_button_icon_padding</item>
        <item name="iconTint">@color/yp_black</item>
        <item name="fontFamily">@font/ys_display_medium</item>
    </style>

    <style name="PreferencesLinearLayout">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">@dimen/pref_line_height</item>
        <item name="android:layout_marginStart">@dimen/main_button_margin_side</item>
        <item name="android:orientation">horizontal</item>
    </style>

    <style name="PreferencesTextView">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:gravity">center</item>
        <item name="android:text">@string/choose_theme</item>
        <item name="android:textColor">@color/yp_black</item>
        <item name="android:textSize">@dimen/pref_text_size</item>
        <item name="fontFamily">@font/ys_display_regular</item>
    </style>

    <style name="PreferencesView">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">0dp</item>
        <item name="android:layout_weight">1</item>
    </style>

    <style name="PreferencesImageView">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_gravity">center</item>
        <item name="android:layout_marginEnd">@dimen/main_button_margin_side</item>
        <item name="android:contentDescription">@null</item>
        <item name="android:src">@drawable/ic_arrow_forward</item>
        <item name="tint">@color/yp_text_gray</item>
    </style>

    <style name="PreferencesMainLayout">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:background">@color/white</item>
        <item name="android:orientation">vertical</item>
    </style>

    <style name="PreferencesHeader">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_marginStart">24dp</item>
        <item name="android:layout_marginBottom">2dp</item>
        <item name="android:gravity">center</item>
        <item name="android:textColor">@color/yp_black</item>
        <item name="android:fontFamily">@font/ys_display_medium</item>
        <item name="android:textSize">@dimen/main_text_size</item>
    </style>

    <style name="MainBackground">
        <item name="android:background">@color/yp_blue</item>
    </style>

    <style name="PreferencesBackArrow">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_gravity">center</item>
        <item name="android:layout_marginStart">16dp</item>
        <item name="android:contentDescription">@null</item>
        <item name="android:scaleType">centerInside</item>
        <item name="android:background">@color/white</item>
        <item name="android:tint">@color/yp_black</item>
    </style>

    <style name="SearchEditText">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">36dp</item>
        <item name="android:layout_marginHorizontal">16dp</item>
        <item name="android:layout_marginVertical">8dp</item>
        <item name="android:autofillHints">true</item>
        <item name="android:background">@drawable/search_edittext_rounded_background</item>
        <item name="android:drawablePadding">10dp</item>
        <item name="android:drawableTint">@color/yp_text_gray</item>
        <item name="android:fontFamily">@font/ys_text_regular</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:textColorHint">@color/yp_text_gray</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/yp_black</item>
    </style>

    <style name="clearSearchButton">
        <item name="android:layout_width">40dp</item>
        <item name="android:layout_height">36dp</item>
        <item name="android:layout_gravity">end</item>
        <item name="android:layout_marginHorizontal">16dp</item>
        <item name="android:layout_marginVertical">8dp</item>
        <item name="android:tint">@color/yp_text_gray</item>
    </style>

    <style name="SearchDelimeterImageView">
        <item name="android:layout_width">13dp</item>
        <item name="android:layout_height">13dp</item>
        <item name="android:contentDescription">@null</item>
        <item name="tint">@color/yp_text_gray</item>
    </style>

    <style name="SearchTrackNameText">
        <item name="android:fontFamily">@font/ys_display_regular</item>
        <item name="android:textColor">@color/yp_black</item>
        <item name="android:textSize">16sp</item>
    </style>

    <style name="SearchTrackArtistText">
        <item name="android:fontFamily">@font/ys_display_regular</item>
        <item name="android:textColor">@color/yp_text_gray</item>
        <item name="android:textSize">11sp</item>
    </style>

    <style name="searchErrorPlaceholder">
        <item name="android:src">@drawable/search_error_placeholder_light</item>
    </style>

    <style name="searchErrorPlaceholderText">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_gravity">center</item>
        <item name="android:layout_marginTop">16dp</item>
        <item name="android:fontFamily">@font/ys_display_medium</item>
        <item name="android:textColor">@color/yp_black</item>
        <item name="android:textSize">19sp</item>
    </style>

    <style name="internetErrorPlaceholder">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_gravity">center</item>
        <item name="android:layout_marginTop">102dp</item>
        <item name="android:scaleType">center</item>
        <item name="android:src">@drawable/internet_error_placeholder_light</item>
    </style>

    <style name="searchRefreshButton">
        <item name="android:layout_width">91dp</item>
        <item name="android:layout_height">36dp</item>
        <item name="android:layout_gravity">center</item>
        <item name="android:layout_marginTop">24dp</item>
        <item name="android:fontFamily">@font/ys_display_medium</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:letterSpacing">0.0</item>
        <item name="android:paddingStart">6dp</item>
        <item name="android:paddingTop">4dp</item>
        <item name="android:paddingEnd">8dp</item>
        <item name="android:paddingBottom">4dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">14sp</item>
        <item name="backgroundTint">@color/yp_black</item>
        <item name="cornerRadius">54dp</item>
    </style>
</resources>