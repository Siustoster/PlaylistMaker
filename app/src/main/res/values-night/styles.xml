<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="MainWindowButtonStyle">
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">@dimen/main_text_size</item>
        <item name="cornerRadius">@dimen/main_button_corner_radius</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:textColor">@color/yp_black</item>
        <item name="android:letterSpacing">0.0</item>
        <item name="android:backgroundTint">@color/white</item>
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">0dp</item>
        <item name="android:layout_weight">1</item>
        <item name="iconGravity">textStart</item>
        <item name="iconPadding">@dimen/main_button_icon_padding</item>
        <item name="iconTint">@color/yp_black</item>
        <item name="fontFamily">@font/ys_display_medium</item>
    </style>

    <style name="PreferencesLinearLayout">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">@dimen/pref_line_height</item>
        <item name="android:layout_marginStart">@dimen/main_button_margin_side</item>
        <item name="android:orientation">horizontal</item>
    </style>

    <style name="PreferencesTextView">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:gravity">center</item>
        <item name="android:text">@string/choose_theme</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">@dimen/pref_text_size</item>
        <item name="fontFamily">@font/ys_display_regular</item>
    </style>

    <style name="PreferencesView">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">0dp</item>
        <item name="android:layout_weight">1</item>
    </style>

    <style name="PreferencesImageView">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_gravity">center</item>
        <item name="android:layout_marginEnd">@dimen/main_button_margin_side</item>
        <item name="android:contentDescription">@null</item>
        <item name="android:src">@drawable/ic_arrow_forward</item>
        <item name="tint">@color/white</item>
    </style>

    <style name="PreferencesMainLayout">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:background">@color/yp_black</item>
        <item name="android:orientation">vertical</item>
    </style>

    <style name="PreferencesHeader">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_marginStart">24dp</item>
        <item name="android:layout_marginBottom">2dp</item>
        <item name="android:gravity">center</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:fontFamily">@font/ys_display_medium</item>
        <item name="android:textSize">@dimen/main_text_size</item>
    </style>

    <style name="MainBackground">
        <item name="android:background">@color/yp_black</item>
    </style>

    <style name="PreferencesBackArrow">
        <item name="android:background">@color/yp_black</item>
        <item name="android:tint">@color/white</item>
    </style>
</resources>