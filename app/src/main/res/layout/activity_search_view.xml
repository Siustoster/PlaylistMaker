<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/search_activity"
    style="@style/PreferencesMainLayout">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/search_back_button"
            style="@style/PreferencesBackArrow"
            android:src="@drawable/ic_back_arrow_24" />

        <TextView
            style="@style/PreferencesHeader"
            android:text="@string/search_button" />
    </LinearLayout>

    <LinearLayout
        style="@style/PreferencesLinearLayout"
        android:layout_marginStart="0dp"
        android:orientation="horizontal">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <EditText
                android:id="@+id/search_edit_text"
                style="@style/SearchEditText"
                android:autofillHints="true"
                android:drawableStart="@drawable/ic_search_edit_text_16"
                android:hint="@string/search_button"
                android:imeOptions="actionDone"
                android:inputType="text"
                android:maxLines="1"
                android:singleLine="true" />


            <ImageView
                android:id="@+id/clear_search_button"
                style="@style/clearSearchButton"
                android:contentDescription="@string/clear_button_desc"
                android:scaleType="center"
                android:src="@drawable/ic_clear_cross_16"
                android:visibility="invisible" />
        </FrameLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/historyLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="visible">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                style="@style/searchErrorPlaceholderText"
                android:layout_width="wrap_content"
                android:layout_height="22dp"
                android:layout_marginTop="0dp"
                android:text="@string/history_header" />

        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/historyRecyclerView"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="8dp"
            android:layout_weight="1"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/clearHistoryButton"
            style="@style/searchRefreshButton"
            android:layout_width="148dp"
            android:layout_height="36dp"
            android:contentDescription="@string/clear_history"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="@string/clear_history" />
    </LinearLayout>


    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />

    <ImageView
        android:id="@+id/search_error_placeholder"
        style="@style/searchErrorPlaceholder"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginTop="102dp"
        android:contentDescription="@string/search_error_placeholder"
        android:scaleType="center"
        android:visibility="gone" />

    <TextView
        android:id="@+id/search_error_placeholder_text"
        style="@style/searchErrorPlaceholderText"
        android:text="@string/search_error_placeholder"
        android:visibility="gone" />

    <ImageView
        android:id="@+id/internet_error_placeholder"
        style="@style/internetErrorPlaceholder"
        android:contentDescription="@string/internet_error_placeholder"
        android:visibility="gone" />

    <TextView
        android:id="@+id/internet_error_placeholder_text"
        style="@style/searchErrorPlaceholderText"
        android:layout_width="312dp"
        android:text="@string/internet_error_placeholder"
        android:textAlignment="center"
        android:visibility="gone" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/searchRefreshButton"
        style="@style/searchRefreshButton"
        android:text="@string/refreshSearchButton"
        android:visibility="gone" />
</LinearLayout>