<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/search_activity"
    style="@style/PreferencesMainLayout">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/search_back_button"
            style="@style/PreferencesBackArrow"
            android:src="@drawable/ic_back_arrow_24" />

        <TextView
            style="@style/PreferencesHeader"
            android:text="@string/search_button" />
    </LinearLayout>

    <LinearLayout
        style="@style/PreferencesLinearLayout"
        android:layout_marginStart="0dp"
        android:orientation="horizontal">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <EditText
                android:id="@+id/search_edit_text"
                style="@style/SearchEditText"
                android:autofillHints="true"
                android:drawableStart="@drawable/ic_search_edit_text_16"
                android:hint="@string/search_button"
                android:inputType="text"
                android:maxLines="1" />


            <ImageView
                android:id="@+id/clear_search_button"
                style="@style/clearSearchButton"
                android:contentDescription="@string/clear_button_desc"
                android:scaleType="center"
                android:src="@drawable/ic_clear_cross_16"
                android:visibility="invisible" />
        </FrameLayout>
    </LinearLayout>
</LinearLayout>