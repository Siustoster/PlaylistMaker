<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/headerLine"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            app:layout_constraintGuide_begin="56dp" />


        <ImageButton
            android:id="@+id/backArrow"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="4dp"
            android:layout_marginTop="4dp"
            android:background="@color/white"
            android:scaleType="center"
            android:src="@drawable/ic_back_arrow_24"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="@color/yp_black" />


        <ImageView
            android:id="@+id/albumCover"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginStart="24dp"
            android:layout_marginTop="26dp"
            android:layout_marginEnd="24dp"
            android:src="@drawable/search_error_placeholder_dark"
            app:layout_constraintDimensionRatio="1:1"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/headerLine"
            app:tint="@color/yp_black" />

        <TextView
            android:id="@+id/trackName"
            android:layout_width="0dp"
            android:layout_height="26dp"
            android:layout_marginTop="24dp"
            android:fontFamily="@font/ys_display_medium"
            android:letterSpacing="0"
            android:text="Yesterday (Remastered 2009)"
            android:textColor="@color/yp_black"
            android:textSize="22sp"
            app:layout_constraintEnd_toEndOf="@id/albumCover"
            app:layout_constraintStart_toStartOf="@id/albumCover"
            app:layout_constraintTop_toBottomOf="@id/albumCover" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="16dp"
            android:layout_marginTop="12dp"
            android:fontFamily="@font/ys_display_medium"
            android:text="The Beatles"
            android:textColor="@color/yp_black"
            android:textSize="14sp"
            app:layout_constraintEnd_toEndOf="@id/albumCover"
            app:layout_constraintStart_toStartOf="@id/albumCover"
            app:layout_constraintTop_toBottomOf="@id/trackName" />
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.core.widget.NestedScrollView>