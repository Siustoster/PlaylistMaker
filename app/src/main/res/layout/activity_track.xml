<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/track_activity"
    style="@style/playerMainStyle"
    >

    <androidx.constraintlayout.widget.ConstraintLayout
        style="@style/playerMainStyle">
        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/headerLine"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            app:layout_constraintGuide_begin="56dp" />
        <ImageButton
            android:id="@+id/trackBackArrow"
            style="@style/PreferencesBackArrow"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="4dp"
            android:layout_marginTop="4dp"
            android:contentDescription="@string/back_button_desc"
            android:scaleType="center"
            android:src="@drawable/ic_back_arrow_24"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />
        <ImageView
            android:id="@+id/albumCover"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginStart="24dp"
            android:layout_marginTop="26dp"
            android:layout_marginEnd="24dp"
            android:contentDescription="@string/album_cover"
            android:scaleType="centerCrop"
            app:layout_constraintDimensionRatio="1:1"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/headerLine" />
        <TextView
            android:id="@+id/ta_trackName"
            style="@style/playerTrackNameStyle"
            android:layout_width="0dp"
            android:layout_height="26dp"
            android:layout_marginTop="24dp"
            app:layout_constraintEnd_toEndOf="@id/albumCover"
            app:layout_constraintStart_toStartOf="@id/albumCover"
            app:layout_constraintTop_toBottomOf="@id/albumCover" />
        <TextView
            android:id="@+id/authorName"
            style="@style/playerArtistNameStyle"
            android:layout_width="0dp"
            android:layout_height="16dp"
            android:layout_marginTop="12dp"
            app:layout_constraintEnd_toEndOf="@id/albumCover"
            app:layout_constraintStart_toStartOf="@id/albumCover"
            app:layout_constraintTop_toBottomOf="@id/ta_trackName" />
        <ImageButton
            android:id="@+id/addToPlaylistButton"
            android:layout_width="51dp"
            android:layout_height="51dp"
            android:layout_marginTop="54dp"
            android:background="@android:color/transparent"
            android:contentDescription="@string/add_to_playlist"
            android:scaleType="centerInside"
            android:src="@drawable/ic_add_to_playlist_button"
            app:layout_constraintEnd_toStartOf="@id/playButton"
            app:layout_constraintHorizontal_chainStyle="spread_inside"
            app:layout_constraintStart_toStartOf="@id/authorName"
            app:layout_constraintTop_toBottomOf="@id/authorName" />
        <ImageButton
            android:id="@+id/playButton"
            style="@style/playerPlayButtonStyle"
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:layout_marginStart="55dp"
            android:layout_marginTop="30dp"
            android:background="@android:color/transparent"
            android:contentDescription="@string/play_button_desc"
            android:scaleType="center"
            android:src="@drawable/ic_play_button_100"
            app:layout_constraintEnd_toStartOf="@id/trackFavButton"
            app:layout_constraintStart_toEndOf="@id/addToPlaylistButton"
            app:layout_constraintTop_toBottomOf="@id/authorName"
            />
        <ImageButton
            android:id="@+id/trackFavButton"
            android:layout_width="51dp"
            android:layout_height="51dp"
            android:layout_marginStart="55dp"
            android:background="@android:color/transparent"
            android:contentDescription="@string/add_to_favourites"
            android:scaleType="centerInside"
            android:src="@drawable/ic_fav_button_51"
            app:layout_constraintEnd_toEndOf="@id/authorName"
            app:layout_constraintStart_toEndOf="@+id/playButton"
            app:layout_constraintTop_toTopOf="@id/addToPlaylistButton" />
        <TextView
            android:id="@+id/currentTrackPlayTime"
            style="@style/playerArtistNameStyle"
            android:layout_width="0dp"
            android:layout_height="16dp"
            android:layout_marginTop="4dp"
            android:gravity="center"
            android:minHeight="24dp"
            android:paddingTop="1dp"
            android:text="00:00"
            app:layout_constraintEnd_toEndOf="@id/playButton"
            app:layout_constraintStart_toStartOf="@id/playButton"
            app:layout_constraintTop_toBottomOf="@id/playButton" />
        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/left_guideline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintGuide_begin="16dp" />
        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/right_guideline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintGuide_end="16dp" />
        <TextView
            android:id="@+id/trackLengthText"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:layout_marginTop="30dp"
            android:fontFamily="@font/ys_display_regular"
            android:gravity="center"
            android:text="@string/track_length"
            android:textColor="@color/yp_text_gray"
            android:textSize="13sp"
            app:layout_constraintStart_toStartOf="@id/left_guideline"
            app:layout_constraintTop_toBottomOf="@id/currentTrackPlayTime" />
        <TextView
            android:id="@+id/trackLength"
            android:layout_width="0dp"
            android:layout_height="32dp"
            android:textAlignment="viewEnd"
            style="@style/playerTrackDescriptionStyle"
            app:layout_constraintBaseline_toBaselineOf="@id/trackLengthText"
            app:layout_constraintEnd_toStartOf="@id/right_guideline"
            app:layout_constraintStart_toEndOf="@id/trackLengthText"
            app:layout_constraintTop_toTopOf="@id/trackLengthText" />

        <TextView
            android:id="@+id/albumNameText"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:fontFamily="@font/ys_display_regular"
            android:gravity="center"
            android:text="@string/album_name"
            android:textColor="@color/yp_text_gray"
            android:textSize="13sp"
            app:layout_constraintStart_toStartOf="@id/left_guideline"
            app:layout_constraintTop_toBottomOf="@id/trackLengthText" />
        <TextView
            android:id="@+id/albumName"
            android:layout_width="0dp"
            android:layout_height="32dp"
            android:textAlignment="viewEnd"
            style="@style/playerTrackDescriptionStyle"
            app:layout_constraintBaseline_toBaselineOf="@id/albumNameText"
            app:layout_constraintEnd_toStartOf="@id/right_guideline"
            app:layout_constraintStart_toEndOf="@id/albumNameText"
            app:layout_constraintTop_toTopOf="@id/albumNameText" />
        <TextView
            android:id="@+id/yearText"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:fontFamily="@font/ys_display_regular"
            android:gravity="center"
            android:text="@string/year"
            android:textColor="@color/yp_text_gray"
            android:textSize="13sp"
            app:layout_constraintStart_toStartOf="@id/left_guideline"
            app:layout_constraintTop_toBottomOf="@id/albumNameText" />
        <TextView
            android:id="@+id/year"
            android:layout_width="0dp"
            android:layout_height="32dp"
            android:textAlignment="viewEnd"
            style="@style/playerTrackDescriptionStyle"
            app:layout_constraintBaseline_toBaselineOf="@id/yearText"
            app:layout_constraintEnd_toStartOf="@id/right_guideline"
            app:layout_constraintStart_toEndOf="@id/yearText"
            app:layout_constraintTop_toTopOf="@id/yearText" />
        <TextView
            android:id="@+id/genreText"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:fontFamily="@font/ys_display_regular"
            android:gravity="center"
            android:text="@string/genre_name"
            android:textColor="@color/yp_text_gray"
            android:textSize="13sp"
            app:layout_constraintStart_toStartOf="@id/left_guideline"
            app:layout_constraintTop_toBottomOf="@id/yearText" />
        <TextView
            android:id="@+id/genre"
            android:layout_width="0dp"
            android:layout_height="32dp"
            android:textAlignment="viewEnd"
            style="@style/playerTrackDescriptionStyle"
            app:layout_constraintBaseline_toBaselineOf="@id/genreText"
            app:layout_constraintEnd_toStartOf="@id/right_guideline"
            app:layout_constraintStart_toEndOf="@id/genreText"
            app:layout_constraintTop_toTopOf="@id/genreText" />
        <TextView
            android:id="@+id/countryText"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:fontFamily="@font/ys_display_regular"
            android:gravity="center"
            android:text="@string/country"
            android:textColor="@color/yp_text_gray"
            android:textSize="13sp"
            app:layout_constraintStart_toStartOf="@id/left_guideline"
            app:layout_constraintTop_toBottomOf="@id/genreText" />
        <TextView
            android:id="@+id/country"
            android:layout_width="0dp"
            android:layout_height="32dp"
            android:textAlignment="viewEnd"
            style="@style/playerTrackDescriptionStyle"
            app:layout_constraintBaseline_toBaselineOf="@id/countryText"
            app:layout_constraintEnd_toStartOf="@id/right_guideline"
            app:layout_constraintStart_toEndOf="@id/countryText"
            app:layout_constraintTop_toTopOf="@id/countryText" />
        <androidx.constraintlayout.widget.Group
            android:id="@+id/countryGroup"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="visible"
            app:constraint_referenced_ids="countryText,country" />
        <androidx.constraintlayout.widget.Group
            android:id="@+id/genreGroup"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="visible"
            app:constraint_referenced_ids="genre,genreText" />
        <androidx.constraintlayout.widget.Group
            android:id="@+id/yearGroup"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="visible"
            app:constraint_referenced_ids="year,yearText" />
        <androidx.constraintlayout.widget.Group
            android:id="@+id/albumGroup"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="visible"
            app:constraint_referenced_ids="albumName,albumNameText" />
    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.core.widget.NestedScrollView>